# =============================================================================
# LoveCheck — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# =============================================================================

# --- API Server ---
NODE_ENV=production
PORT=3001

# MongoDB connection string
# Local docker: mongodb://mongo:27017/checkinlove
# Atlas: mongodb+srv://user:pass@cluster.mongodb.net/checkinlove
MONGODB_URI=mongodb://mongo:27017/checkinlove

# JWT secret — must be at least 32 random characters
JWT_SECRET=change_me_to_a_very_long_random_string_min_32_chars

# Admin credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_strong_password

# Enables destructive admin-only reset endpoint for repeated testing.
# Keep false in production.
ADMIN_ENABLE_TEST_RESET=false

# Public base URL for API (used in file URLs etc.)
PUBLIC_BASE_URL=https://api.couple.io.vn

# Upload directory (inside container, mapped to a Docker volume)
UPLOAD_DIR=/app/uploads

# Max upload size in MB
MAX_UPLOAD_MB=10

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=https://couple.io.vn,https://admin.couple.io.vn

# --- Web Push (Optional — generate with: npx web-push generate-vapid-keys) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=admin@couple.io.vn

# --- Email OTP (Gmail or Custom Domain SMTP) (Optional) ---
# Option 1: Custom Domain SMTP (Hostinger, Zoho, SendGrid, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=hello@couple.io.vn
SMTP_PASS=
SMTP_FROM="Check IN Love 💕" <hello@couple.io.vn>

# Option 2: Gmail (if using Google Account / Workspace)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- Google Sign-In ---
# Use the same OAuth 2.0 Web client ID for the API and PWA build.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# --- FCM Push Notifications (Optional) ---
# Legacy FCM Server Key (do not use for new deployments)
FCM_SERVER_KEY=
# Modern FCM HTTP v1 (recommended). Use exactly one option in production.
# FCM_SERVICE_ACCOUNT_JSON must contain the whole service-account JSON on one
# line; preserve the private_key newline escapes and never commit it.
FCM_SERVICE_ACCOUNT_FILE=
FCM_SERVICE_ACCOUNT_JSON=

# --- PWA ---
VITE_API_URL=https://api.couple.io.vn/api

# --- Admin ---
# (Admin uses same VITE_API_URL — set per-service in docker-compose)
