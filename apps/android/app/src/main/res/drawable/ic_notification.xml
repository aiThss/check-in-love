<?xml version="1.0" encoding="utf-8"?>
<!--
    Monochrome notification silhouette based on the Check in Love PWA
    pixel-heart logo. Android status-bar notification icons must be white
    on transparent background; Android applies the notification tint.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Pixel-heart body -->
    <path android:fillColor="#FFFFFFFF" android:pathData="M6,3 h4 v2 h4 v-2 h4 v2 h2 v6 h-2 v4 h-2 v2 h-2 v2 h-2 v2 h-2 v-2 h-2 v-2 h-2 v-2 h-2 v-4 h-2 v-6 h2 z"/>
    <path android:fillColor="#FFFFFFFF" android:pathData="M4,7 h16 v4 h-2 v4 h-2 v2 h-2 v2 h-4 v-2 h-2 v-2 h-2 v-4 h-2 z"/>

    <!-- Four-point pixel sparkles -->
    <path android:fillColor="#FFFFFFFF" android:pathData="M3,1 h2 v2 h2 v2 h-2 v2 h-2 v-2 h-2 v-2 h2 z"/>
    <path android:fillColor="#FFFFFFFF" android:pathData="M19,1 h2 v2 h2 v2 h-2 v2 h-2 v-2 h-2 v-2 h2 z"/>
    <path android:fillColor="#FFFFFFFF" android:pathData="M3,18 h2 v2 h2 v2 h-2 v2 h-2 v-2 h-2 v-2 h2 z"/>
    <path android:fillColor="#FFFFFFFF" android:pathData="M19,17 h2 v2 h2 v2 h-2 v2 h-2 v-2 h-2 v-2 h2 z"/>
</vector>
