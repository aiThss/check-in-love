<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quick_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_photo_background"
    android:clipToOutline="true"
    android:outlineProvider="background">

    <!-- The partner's check-in photo background -->
    <ImageView
        android:id="@+id/quick_widget_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null"
        android:visibility="gone" />

    <!-- Dark gradient scrim overlay to make text highly readable -->
    <View
        android:id="@+id/quick_widget_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_photo_scrim"
        android:visibility="gone" />

    <!-- Content overlay -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="36dp">

        <TextView
            android:id="@+id/quick_widget_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/be_vietnam_pro_extra_bold"
            android:gravity="center"
            android:includeFontPadding="false"
            android:letterSpacing="-0.01"
            android:maxLines="2"
            android:text="Nhan de gui check-in..."
            android:textAlignment="center"
            android:textColor="#FFFFFF"
            android:textSize="22sp" />
    </LinearLayout>
</FrameLayout>
